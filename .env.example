# Copy this file to .env and fill in the values.

# Bot token: https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_TOKEN=

# Application ID: your app → General Information → Application ID
DISCORD_CLIENT_ID=

# Optional: a server ID to register slash commands to instantly while developing.
# Leave empty to register commands globally.
DISCORD_GUILD_ID=

# Optional: set to true to convert .lrc files dropped in any channel the bot can
# see. Without it, dropped files are converted in DMs and when the bot is
# @mentioned. Needs "Message Content Intent" turned on under your app → Bot in
# the Developer Portal, or the bot won't be able to log in.
WATCH_ALL_CHANNELS=
