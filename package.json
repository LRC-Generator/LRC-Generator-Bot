{
  "name": "lrc-generator-bot",
  "version": "1.0.0",
  "description": "Discord bot for LRC Generator",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "deploy-commands": "tsx --env-file-if-exists=.env src/deploy-commands.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LRC-Generator/LRC-Generator-Bot.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/LRC-Generator/LRC-Generator-Bot/issues"
  },
  "homepage": "https://github.com/LRC-Generator/LRC-Generator-Bot#readme",
  "dependencies": {
    "discord.js": "^14.28.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
